# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://aicrp:aicrp_deDATABASE_URL=postgresql://postgres:swara@localhost:5432/aicrp_goat_breeding?schema=publicv_password@localhost:5432/aicrp_goat_breeding?schema=public

# CORS — admin panel origin (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# JWT (change in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
